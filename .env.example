# Copy to .env and fill in. .env is gitignored.

# ── Braintrust ───────────────────────────────────────────────────────────────
# Free tier, no credit card. Create at braintrust.dev → Settings → API keys.
BRAINTRUST_API_KEY=sk-bt-...
BRAINTRUST_PROJECT="JWST Research Agent"

# ── Which model runs the agent ───────────────────────────────────────────────
# Two options. Pick one.
#
# A) Anthropic via the Braintrust gateway (no OpenAI account needed).
#    Add your Anthropic key in Braintrust: Settings → AI providers → Anthropic.
#    Then uncomment this line. Requests go out in OpenAI format and Braintrust
#    routes them to Anthropic, so switching model is a name change and nothing
#    else. Your Anthropic account is billed directly.
# BRAINTRUST_GATEWAY_URL=https://gateway.braintrust.dev/v1
#
# B) OpenAI directly. Leave the gateway line commented and set this instead.
# OPENAI_API_KEY=sk-...

# The model under test, and the model that grades the writing check.
# Both Haiku here, which is the cheapest option (~$1 for the full comparison).
# The judge grades against an expected answer derived from the data rather than
# on open-ended preference, so same-model grading is a mild concern, not a
# fatal one. Set JUDGE_MODEL=claude-sonnet-5 if you want them independent.
AGENT_MODEL=claude-haiku-4-5
JUDGE_MODEL=claude-haiku-4-5

# ── Which prompt versions to run ─────────────────────────────────────────────
#   v1-grounded             the baseline
#   v1-grounded,v2-concise  the comparison that surfaces the regression
PROMPT_VERSIONS=v1-grounded

# Repeats per question. The regression is a shift in how often the agent skips
# a step, not a hard failure, so one run per question buries it in noise.
TRIAL_COUNT=3

MAX_CONCURRENCY=4
# EVAL_LIMIT=3     # uncomment for a cheap smoke run
